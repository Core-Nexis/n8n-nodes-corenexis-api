{
	"name": "@corenexis/n8n-nodes-corenexis-api",
	"version": "0.1.1",
	"description": "n8n community node for the Corenexis API: Markdown and HTML to PDF, image and PDF OCR, email validation, disposable email detection, image conversion, image hosting, QR codes and barcodes.",
	"license": "MIT",
	"homepage": "https://github.com/Core-Nexis/n8n-nodes-corenexis-api#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"corenexis",
		"pdf",
		"html to pdf",
		"markdown to pdf",
		"ocr",
		"email validation",
		"image conversion",
		"qr code"
	],
	"author": {
		"name": "Corenexis",
		"email": "support@corenexis.com",
		"url": "https://corenexis.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Core-Nexis/n8n-nodes-corenexis-api.git"
	},
	"bugs": {
		"url": "https://github.com/Core-Nexis/n8n-nodes-corenexis-api/issues",
		"email": "support@corenexis.com"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/CorenexisApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/CorenexisApi/CorenexisApi.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
